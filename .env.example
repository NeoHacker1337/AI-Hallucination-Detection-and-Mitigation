# Copy to .env and adjust. Every value is optional; defaults are shown.

# --- Storage ---
HG_DATA_DIR=data
HG_DATABASE_URL=sqlite:///data/halluguard.db

# --- LLM backends ---
# Model specs are "provider:model": ollama:llama3, ollama:mistral, ollama:phi3, openai:gpt-4o-mini
HG_DEFAULT_MODEL=ollama:llama3
OLLAMA_BASE_URL=http://localhost:11434
# Any OpenAI-compatible endpoint (OpenAI, vLLM, LM Studio, Groq, Together, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
HG_LLM_TIMEOUT_S=180
HG_LLM_MAX_RETRIES=3

# --- Retrieval and NLI models (Hugging Face ids) ---
HG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Smaller/faster alternative for laptops: microsoft/deberta-base-mnli
HG_NLI_MODEL=microsoft/deberta-large-mnli
# auto | cpu | cuda | mps
HG_DEVICE=auto
HG_NLI_BATCH_SIZE=16

# --- Datasets (override only if you use mirrors) ---
HG_TRUTHFULQA_ID=truthfulqa/truthful_qa
HG_HALUEVAL_ID=pminervini/HaluEval

# --- Chunking for the knowledge base ---
HG_CHUNK_WORDS=180
HG_CHUNK_OVERLAP_WORDS=40

# --- Experiments ---
HG_MAX_PARALLEL_EXPERIMENTS=1

# Optional web retrieval (configuration override web_search="wikipedia"; off in every preset).
# Wikimedia requires a User-Agent with contact details (URL or e-mail); requests are refused without it.
HG_WEB_USER_AGENT=
HG_WEB_TIMEOUT_S=10
